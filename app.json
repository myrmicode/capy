{
  "expo": {
    "name": "Capy",
    "slug": "capy",
    "scheme": "capy",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/capy/icone-appli-carree.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#faf9f5",
        "foregroundImage": "./assets/capy/icone-appli-carree.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/capy/icone-appli-carree.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/capy/icone-appli-carree.png",
          "imageWidth": 200,
          "backgroundColor": "#faf9f5"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
