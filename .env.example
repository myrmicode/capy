# Copiez ce fichier en « .env » (même dossier) et remplissez les deux valeurs.
# Elles se trouvent dans Supabase : Project Settings > API Keys (et Data API pour l'URL).
#
# Ces deux valeurs sont publiques par conception : la clé « publishable » sert
# seulement à appeler la fonction. La clé de l'API Claude, elle, n'est JAMAIS ici :
# elle reste dans les secrets de la fonction Supabase.
EXPO_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
